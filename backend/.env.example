DATABASE_URL=postgresql://postgres@localhost:5433/quizmaster
ANTHROPIC_API_KEY=
ANTHROPIC_WORKSPACE_ID=
OPENAI_API_KEY=

# Section 3 (Clerk auth, PLAN.md section 8): the Clerk app's Frontend API
# URL, from the Clerk dashboard -> API Keys (looks like
# https://your-app-name.clerk.accounts.dev, or your custom domain once
# configured). Used to verify session JWTs via Clerk's own JWKS endpoint —
# no secret key needed for verification.
CLERK_ISSUER=

# Origin the frontend dev server (or deployed frontend) runs on, for CORS.
FRONTEND_ORIGIN=http://localhost:5173

# Optional, defaults shown (SPEC section 15 / PLAN.md section 2 section 8):
# DAILY_QUIZ_GENERATION_LIMIT=10
# OVERGENERATION_FACTOR=1.0
# OVERGENERATION_CAP=5

# Optional: override where catalog.py/generation.py/explanations.py look for
# Section 1's Chroma store. Defaults to ingestion/chroma_db relative to the
# repo root, which only works if that folder is deployed at that same
# relative path. Set this if the deployed backend mounts chroma_db somewhere
# else (e.g. a persistent disk path on the hosting provider).
# CHROMA_DB_PATH=/path/to/chroma_db
